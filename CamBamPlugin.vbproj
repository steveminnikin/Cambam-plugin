<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{BEC3EAAC-3108-4E08-B234-DC8937DB0A20}</ProjectGuid>
    <OutputType>Library</OutputType>
    <RootNamespace>CamBamPlugin</RootNamespace>
    <AssemblyName>CamBamPlugin</AssemblyName>
    <FileAlignment>512</FileAlignment>
    <MyType>Windows</MyType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <TargetFrameworkProfile />
    <!-- CamBam installation folder. Set the CamBamDir environment variable (or
         msbuild /p:CamBamDir=...) if CamBam is installed somewhere else; the
         probes below only apply when it is not set. -->
    <CamBamDir Condition=" '$(CamBamDir)' == '' And Exists('C:\Program Files\CamBam plus 1.0\CamBam.CAD.dll') ">C:\Program Files\CamBam plus 1.0</CamBamDir>
    <CamBamDir Condition=" '$(CamBamDir)' == '' And Exists('C:\Program Files (x86)\CamBam plus 1.0\CamBam.CAD.dll') ">C:\Program Files (x86)\CamBam plus 1.0</CamBamDir>
    <CamBamDir Condition=" '$(CamBamDir)' == '' And Exists('C:\Program Files (x86)\CamBam plus 0.9.8\CamBam.CAD.dll') ">C:\Program Files (x86)\CamBam plus 0.9.8</CamBamDir>
    <CamBamDir Condition=" '$(CamBamDir)' == '' And Exists('C:\Program Files\CamBam plus 0.9.8\CamBam.CAD.dll') ">C:\Program Files\CamBam plus 0.9.8</CamBamDir>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <DefineDebug>true</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <OutputPath>bin\Debug\</OutputPath>
    <DocumentationFile>CamBamPlugin.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
    <!-- AnyCPU so the plugin loads into both the 32 and 64-bit CamBam -->
    <PlatformTarget>AnyCPU</PlatformTarget>
    <StartAction>Program</StartAction>
    <StartProgram>$(CamBamDir)\CamBam.exe</StartProgram>
    <StartWorkingDirectory>$(CamBamDir)</StartWorkingDirectory>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <DefineDebug>false</DefineDebug>
    <DefineTrace>true</DefineTrace>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DocumentationFile>CamBamPlugin.xml</DocumentationFile>
    <NoWarn>42016,41999,42017,42018,42019,42032,42036,42020,42021,42022</NoWarn>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <PropertyGroup>
    <OptionCompare>Binary</OptionCompare>
  </PropertyGroup>
  <PropertyGroup>
    <OptionStrict>Off</OptionStrict>
  </PropertyGroup>
  <PropertyGroup>
    <OptionInfer>On</OptionInfer>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="CamBam.CAD">
      <HintPath>$(CamBamDir)\CamBam.CAD.dll</HintPath>
    </Reference>
    <Reference Include="CamBam.Geom">
      <HintPath>$(CamBamDir)\CamBam.Geom.dll</HintPath>
    </Reference>
    <Reference Include="System" />
    <Reference Include="System.Data" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <Import Include="CamBam" />
    <Import Include="CamBam.CAD" />
    <Import Include="CamBam.CAD.UI" />
    <Import Include="CamBam.CAM" />
    <Import Include="CamBam.Geom" />
    <Import Include="CamBam.UI" />
    <Import Include="CamBam.Util" />
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.IO" />
    <Import Include="System.Text" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="CalForm.Designer.vb">
      <DependentUpon>CalForm.vb</DependentUpon>
    </Compile>
    <Compile Include="CalForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="MyPlugin.vb" />
    <Compile Include="CommonDetails.vb" />
    <Compile Include="DipstickConstants.vb" />
    <Compile Include="DipstickModel.vb" />
    <Compile Include="CalibrationData.vb" />
    <Compile Include="JSONCalibrationParser.vb" />
    <Compile Include="My Project\AssemblyInfo.vb" />
    <Compile Include="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Include="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
    <Compile Include="textForm.Designer.vb">
      <DependentUpon>textForm.vb</DependentUpon>
    </Compile>
    <Compile Include="textForm.vb">
      <SubType>Form</SubType>
    </Compile>
    <Compile Include="UnCalForm.Designer.vb">
      <DependentUpon>UnCalForm.vb</DependentUpon>
    </Compile>
    <Compile Include="UnCalForm.vb">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="CalForm.nqo-GN.resx">
      <DependentUpon>CalForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="CalForm.resx">
      <DependentUpon>CalForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="My Project\Resources.resx">
      <Generator>VbMyResourcesResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.vb</LastGenOutput>
      <CustomToolNamespace>My.Resources</CustomToolNamespace>
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <EmbeddedResource Include="textForm.resx">
      <DependentUpon>textForm.vb</DependentUpon>
    </EmbeddedResource>
    <EmbeddedResource Include="UnCalForm.resx">
      <DependentUpon>UnCalForm.vb</DependentUpon>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <None Include="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Include="My Project\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <CustomToolNamespace>My</CustomToolNamespace>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.VisualBasic.targets" />
  <!-- Fail early with a clear message when the CamBam DLLs cannot be found -->
  <Target Name="CheckCamBamDir" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition=" '$(CamBamDir)' == '' Or !Exists('$(CamBamDir)\CamBam.CAD.dll') "
           Text="CamBam.CAD.dll not found. Set the CamBamDir environment variable (or msbuild /p:CamBamDir=...) to your CamBam installation folder - the one containing CamBam.exe, CamBam.CAD.dll and CamBam.Geom.dll." />
  </Target>
  <!-- Best-effort deploy: copy the built plugin into CamBam's plugins folder.
       Warns instead of failing when the folder is missing or needs elevation. -->
  <Target Name="CopyToCamBamPlugins" AfterTargets="Build" Condition="Exists('$(CamBamDir)\plugins')">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CamBamDir)\plugins" ContinueOnError="true" />
  </Target>
  <!-- To modify your build process, add your task inside one of the targets below and uncomment it.
       Other similar extension points exist, see Microsoft.Common.targets.
  <Target Name="BeforeBuild">
  </Target>
  <Target Name="AfterBuild">
  </Target>
  -->
</Project>